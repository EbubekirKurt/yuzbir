# MongoDB Atlas bağlantı adresi (kullanıcı adı ve şifre dahil)
MONGODB_URI=mongodb+srv://<kullanici>:<sifre>@<cluster-adresi>/?retryWrites=true&w=majority
MONGODB_DB=yuzbir
PORT=3001

# Sitenin adresi (Discord mesajında başlık linki ve "Yeni masa kur" butonu için)
SITE_URL=https://yuzbir-rglz.onrender.com

# Discord: masa bitince sonuç gönderimi. İki yoldan birini doldur, ikisi de boşsa gönderilmez.
# 1) Bot ile (mesaja "Yeni masa kur" butonu da eklenir)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# 2) Webhook ile (bot gerekmez)
DISCORD_WEBHOOK_URL=

# Gönderilemeyen sonuçların yeniden deneme aralığı (dakika, varsayılan 5)
DISCORD_RETRY_MINUTES=5

# Radyodaki sanatçı kanalları (resmi YouTube oynatma listeleri): "Ad|playlistId;Ad 2|playlistId2"
RADIO_YOUTUBE_CHANNELS=Manifest|PLN9sAeoGw4Fh12V2ruXxiIUTQIBz1yZjc
